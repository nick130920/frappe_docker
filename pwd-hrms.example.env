# Copia a pwd-hrms.env y usa:
#   docker compose --env-file pwd-hrms.env -f pwd.yml up -d
#
# Antes debes construir la imagen (ver resources/build-pwd-with-hrms.ps1
# o docs/02-setup/02-build-setup.md). Imagen por defecto local:
PWD_STACK_IMAGE=local/erpnext-hrms
PWD_STACK_TAG=16

# Sitio existente (p. ej. ya tenías ERPNext con la imagen oficial): primero migrate, luego HRMS:
#   docker compose --env-file pwd-hrms.env -f pwd.yml exec backend bench --site frontend migrate
#   docker compose --env-file pwd-hrms.env -f pwd.yml exec backend bench --site frontend install-app hrms
# Si la instalación de hrms quedó a medias: install-app hrms --force y migrate otra vez.
